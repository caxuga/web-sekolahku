# Local development defaults. Never put real credentials in this file.
# Copy to .env.local and replace values on your own machine.

DATABASE_URI=mongodb://127.0.0.1:27017/sekolahku
PAYLOAD_SECRET=replace-with-a-long-random-secret-at-least-32-characters
BASE_URL=http://localhost:3000

# Optional: only required for server-to-server API key integrations.
# Keep these values server-side; never prefix them with NEXT_PUBLIC_.
PAYLOAD_API_KEY=replace-with-a-random-api-key
SERVICE_USER_EMAIL=service@example.com

# Local uploads are used in development.
STORAGE_DRIVER=local

# Optional object storage settings for later Vercel + Cloudflare R2 setup.
# Do not fill production credentials into this tracked file.
S3_BUCKET_NAME=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
